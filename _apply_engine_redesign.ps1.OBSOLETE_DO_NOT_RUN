$new3 = @"
                          (ISNULL(h.opening_nilai,0)+ISNULL(h.beli_nilai,0)) / NULLIF(ISNULL(h.opening_qty,0)+ISNULL(h.beli_qty,0),0) AS HRG
                                FROM costing_helper_movavg h
				) HPP
WHERE  (TSTOK2.STOK_ID = HPP.STOK_ID) AND
		      (TSTOK2.BUKTI_ID = TSTOK1.BUKTI_ID) AND
		      (TSTOK1.TIPE_TRANS not in( '02','05','99','09','19')) AND
		      (TSTOK1.TGL BETWEEN :ldt_tgl1 AND :ldt_tgl2) ;
