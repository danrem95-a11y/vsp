$old3 = @"
                          ISNULL( NULLIF(h.closing_avg,0), (ISNULL(h.opening_nilai,0)+ISNULL(h.beli_nilai,0)) / NULLIF(ISNULL(h.opening_qty,0)+ISNULL(h.beli_qty,0),0) ) AS HRG
