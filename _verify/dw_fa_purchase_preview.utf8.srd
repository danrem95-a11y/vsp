detail(height=84 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.length="100" gradient.repetition.count="0" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(1) update=no name=pilih dbname="pilih" )
 column=(type=char(20) update=no name=voucher dbname="gl_journal.voucher" )
 column=(type=long update=no name=urut dbname="gl_journal.urut" )
 column=(type=date update=no name=tgl dbname="tgl" )
 column=(type=char(100) update=no name=nama_aset dbname="nama_aset" )
 column=(type=char(6) update=no name=golongan dbname="golongan" )
 column=(type=long update=no name=umur dbname="umur" )
 column=(type=decimal(2) update=no name=harga dbname="gl_journal.debet" )
 retrieve="  SELECT 'Y' AS pilih, g.voucher, g.urut, CAST(g.tgl AS DATE) AS tgl, ISNULL(g.ket,'') AS nama_aset, cat.category_code AS golongan, cat.useful_life_month AS umur, g.debet AS harga FROM gl_journal g JOIN FA_CATEGORY cat ON cat.site_id = g.site_id AND cat.asset_account = g.account_id WHERE g.posting = 'P' AND g.site_id = :as_site AND g.debet > 0 AND CAST(g.tgl AS DATE) BETWEEN :ad_from AND :ad_to AND NOT EXISTS ( SELECT 1 FROM FA_ASSET a WHERE a.site_id = g.site_id AND a.source_ref = g.voucher || '#' || CAST(g.urut AS VARCHAR) ) ORDER BY cat.category_code, g.tgl "
 arguments=(("as_site", string),("ad_from", date),("ad_to", date)) )
text(name=pilih_t visible="1" band=header alignment="2" text="Pilih" border="2" color="0" x="0" y="8" height="72" width="150" html.valueishtml="0" font.face="Tahoma" font.height="-9" font.weight="700" font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="12632256" background.transparency="0" )
